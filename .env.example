# ==========================================
# OmniRoute + Nginx + Cloudflare Tunnel Env
# ==========================================

# 1. Cloudflare Tunnel Token
# Obtain from: https://one.dash.cloudflare.com/ (Zero Trust > Networks > Tunnels > Add a Tunnel)
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# 2. OmniRoute Admin Security
# Set a strong initial admin password for the web dashboard login
INITIAL_PASSWORD=ChangeThisAdminPassword123!

# Secret key for JWT signing and session management (generate with: openssl rand -hex 32)
JWT_SECRET=generate_random_secret_with_openssl

# Public Base URL for OAuth callbacks and Dashboard
NEXT_PUBLIC_BASE_URL=https://ai.yourdomain.com
BASE_URL=https://ai.yourdomain.com

# 3. Custom Image & Fast Runtime Selection
# Dockerfile selection:
#   - Dockerfile.v1.1.bun  (Bun on Alpine - ultra-fast startup & high I/O throughput)
#   - Dockerfile.v1.1      (Node.js 22 on Alpine - 100% stable native modules & Next.js)
OMNIROUTE_DOCKERFILE=Dockerfile.v1.1.bun
OMNIROUTE_PKG_VERSION=latest
OMNIROUTE_IMAGE=omniroute

# 4. Optional Port Overrides (Internal Docker Network Defaults)
OMNIROUTE_PORT=20128
NGINX_PORT=80

# 5. Rate Limiting Adjustments (Requests per second for /v1 API)
API_RATE_LIMIT=40r/s
API_BURST=50
AUTH_RATE_LIMIT=30r/m
AUTH_BURST=10
