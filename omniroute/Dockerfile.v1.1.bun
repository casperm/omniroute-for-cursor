# ==============================================================================
# OmniRoute Bun on Alpine Dockerfile (v1.1 Pre-built Package)
# Ultra-fast startup, sub-100MB footprint, and instant build using Bun
# ==============================================================================

FROM oven/bun:alpine

WORKDIR /app

# Install runtime utilities & node (required by omniroute CLI and native bindings)
RUN apk add --no-cache \
    dumb-init \
    su-exec \
    nodejs \
    npm \
    python3 \
    make \
    g++ \
    sqlite-dev \
    libsecret-dev \
    sqlite-libs \
    ca-certificates \
    tzdata \
    libc6-compat \
    gcompat

# Build argument for package version (e.g. latest or specific version like 3.8.49)
ARG OMNIROUTE_PKG_VERSION=latest

# Configure accessible global Bun directory
ENV BUN_INSTALL=/opt/bun
ENV PATH="${BUN_INSTALL}/bin:${PATH}"

# Install pre-built omniroute globally and grant world-readable/executable permissions
RUN mkdir -p /opt/bun && \
    bun install -g omniroute@${OMNIROUTE_PKG_VERSION} && \
    chmod -R 755 /opt/bun && \
    chmod -R a+rx /usr/local/bin 2>/dev/null || true

# Create non-root user
RUN addgroup -g 10001 omniroute && \
    adduser -u 10001 -G omniroute -s /bin/sh -D omniroute

# Setup persistent directory
RUN mkdir -p /app/data && \
    chown -R omniroute:omniroute /app

COPY --chown=omniroute:omniroute docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

ENV NODE_ENV=production
ENV PORT=20128
ENV DATA_DIR=/app/data
ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 20128

ENTRYPOINT ["/usr/bin/dumb-init", "--", "/app/docker-entrypoint.sh"]
CMD ["omniroute", "serve", "--no-open"]
